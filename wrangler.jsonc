{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salesb",
  "main": "src/index.py",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "python_workers",
    "disable_python_external_sdk"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/receive",
      "/receive.php"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS"
    }
  ]
}